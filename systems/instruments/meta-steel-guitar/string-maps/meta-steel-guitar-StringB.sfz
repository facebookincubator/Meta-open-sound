// meta-steel-guitar: full StringB map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
ampeg_release=0.05
pitch_random=4
amp_random=1.5
off_mode=normal

<group> group=5 off_by=5 lovel=1 hivel=48 amp_velcurve_1=0.708 amp_velcurve_48=1
<region> key=59 sample=INSGuitarSteel_StringB_Vel01_B3_01.ogg
<region> key=60 sample=INSGuitarSteel_StringB_Vel01_C4_01.ogg
<region> key=61 sample=INSGuitarSteel_StringB_Vel01_Cs4_01.ogg
<region> key=62 sample=INSGuitarSteel_StringB_Vel01_D4_01.ogg
<region> key=63 sample=INSGuitarSteel_StringB_Vel01_Ds4_01.ogg
<region> key=64 sample=INSGuitarSteel_StringB_Vel01_E4_01.ogg
<region> key=65 sample=INSGuitarSteel_StringB_Vel01_F4_01.ogg
<region> key=66 sample=INSGuitarSteel_StringB_Vel01_Fs4_01.ogg
<region> key=67 sample=INSGuitarSteel_StringB_Vel01_G4_01.ogg
<region> key=68 sample=INSGuitarSteel_StringB_Vel01_Gs4_01.ogg
<region> key=69 sample=INSGuitarSteel_StringB_Vel01_A4_01.ogg
<region> key=70 sample=INSGuitarSteel_StringB_Vel01_As4_01.ogg
<region> key=71 sample=INSGuitarSteel_StringB_Vel01_B4_01.ogg
<region> key=72 sample=INSGuitarSteel_StringB_Vel01_C5_01.ogg
<region> key=73 sample=INSGuitarSteel_StringB_Vel01_Cs5_01.ogg
<region> key=74 sample=INSGuitarSteel_StringB_Vel01_D5_01.ogg
<region> key=75 sample=INSGuitarSteel_StringB_Vel01_Ds5_01.ogg
<region> key=76 sample=INSGuitarSteel_StringB_Vel01_E5_01.ogg
<region> key=77 sample=INSGuitarSteel_StringB_Vel01_F5_01.ogg
<region> key=78 sample=INSGuitarSteel_StringB_Vel01_Fs5_01.ogg
<region> key=79 sample=INSGuitarSteel_StringB_Vel01_G5_01.ogg

<group> group=5 off_by=5 lovel=49 hivel=96 amp_velcurve_49=0.708 amp_velcurve_96=1
