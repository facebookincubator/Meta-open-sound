// meta-steel-guitar: full StringLowE map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
ampeg_release=0.05
pitch_random=4
amp_random=1.5
off_mode=normal

// B2 is the one pitch the Low E string was not recorded at, so key 47 plays A#2
// a semitone up, within the +/-2 semitones the README allows. The keyboard map takes
// B2 from the A string instead.

<group> group=1 off_by=1 lovel=1 hivel=48 amp_velcurve_1=0.708 amp_velcurve_48=1
<region> key=40 sample=INSGuitarSteel_StringLowE_Vel01_E2_01.ogg
<region> key=41 sample=INSGuitarSteel_StringLowE_Vel01_F2_01.ogg
<region> key=42 sample=INSGuitarSteel_StringLowE_Vel01_Fs2_01.ogg
<region> key=43 sample=INSGuitarSteel_StringLowE_Vel01_G2_01.ogg
<region> key=44 sample=INSGuitarSteel_StringLowE_Vel01_Gs2_01.ogg
<region> key=45 sample=INSGuitarSteel_StringLowE_Vel01_A2_01.ogg
<region> key=46 sample=INSGuitarSteel_StringLowE_Vel01_As2_01.ogg
<region> lokey=47 hikey=47 pitch_keycenter=46 sample=INSGuitarSteel_StringLowE_Vel01_As2_01.ogg
<region> key=48 sample=INSGuitarSteel_StringLowE_Vel01_C3_01.ogg
<region> key=49 sample=INSGuitarSteel_StringLowE_Vel01_Cs3_01.ogg
<region> key=50 sample=INSGuitarSteel_StringLowE_Vel01_D3_01.ogg
<region> key=51 sample=INSGuitarSteel_StringLowE_Vel01_Ds3_01.ogg
<region> key=52 sample=INSGuitarSteel_StringLowE_Vel01_E3_01.ogg
<region> key=53 sample=INSGuitarSteel_StringLowE_Vel01_F3_01.ogg
<region> key=54 sample=INSGuitarSteel_StringLowE_Vel01_Fs3_01.ogg
<region> key=55 sample=INSGuitarSteel_StringLowE_Vel01_G3_01.ogg
<region> key=56 sample=INSGuitarSteel_StringLowE_Vel01_Gs3_01.ogg
<region> key=57 sample=INSGuitarSteel_StringLowE_Vel01_A3_01.ogg
<region> key=58 sample=INSGuitarSteel_StringLowE_Vel01_As3_01.ogg
<region> key=59 sample=INSGuitarSteel_StringLowE_Vel01_B3_01.ogg
<region> key=60 sample=INSGuitarSteel_StringLowE_Vel01_C4_01.ogg

<group> group=1 off_by=1 lovel=49 hivel=96 amp_velcurve_49=0.708 amp_velcurve_96=1
<region> key=40 sample=INSGuitarSteel_StringLowE_Vel02_E2_01.ogg
