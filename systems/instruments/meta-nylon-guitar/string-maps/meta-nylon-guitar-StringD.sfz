// meta-nylon-guitar: full StringD map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
sw_lokey=24
sw_hikey=26
sw_default=24
loop_mode=one_shot
off_mode=normal
amp_veltrack=60
pitch_random=4
amp_random=1.5

<group> sw_last=24 group=3 off_by=3 lovel=1 hivel=50 xfout_lovel=35 xfout_hivel=50
<region> key=50 sample=INSGuitarNylon_StringD_Vel01Finger_D3_01.ogg
<region> key=51 sample=INSGuitarNylon_StringD_Vel01Finger_Ds3_01.ogg
<region> key=52 sample=INSGuitarNylon_StringD_Vel01Finger_E3_01.ogg
<region> key=53 sample=INSGuitarNylon_StringD_Vel01Finger_F3_01.ogg
