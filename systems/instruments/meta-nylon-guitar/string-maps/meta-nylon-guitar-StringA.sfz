// meta-nylon-guitar: full StringA map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
sw_lokey=24
sw_hikey=26
sw_default=24
loop_mode=one_shot
off_mode=normal
amp_veltrack=60
pitch_random=4
amp_random=1.5

<group> sw_last=24 group=2 off_by=2 lovel=1 hivel=50 xfout_lovel=35 xfout_hivel=50
<region> key=45 sample=INSGuitarNylon_StringA_Vel01Finger_A2_01.ogg
<region> key=46 sample=INSGuitarNylon_StringA_Vel01Finger_As2_01.ogg
<region> key=47 sample=INSGuitarNylon_StringA_Vel01Finger_B2_01.ogg
<region> key=48 sample=INSGuitarNylon_StringA_Vel01Finger_C3_01.ogg
<region> key=49 sample=INSGuitarNylon_StringA_Vel01Finger_Cs3_01.ogg
