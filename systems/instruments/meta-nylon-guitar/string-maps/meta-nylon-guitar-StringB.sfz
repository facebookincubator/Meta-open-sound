// meta-nylon-guitar: full StringB map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
sw_lokey=24
sw_hikey=26
sw_default=24
loop_mode=one_shot
off_mode=normal
amp_veltrack=60
pitch_random=4
amp_random=1.5

<group> sw_last=24 group=5 off_by=5 lovel=1 hivel=50 xfout_lovel=35 xfout_hivel=50
<region> key=59 sample=INSGuitarNylon_StringB_Vel01Finger_B3_01.ogg
<region> key=60 sample=INSGuitarNylon_StringB_Vel01Finger_C4_01.ogg
<region> key=61 sample=INSGuitarNylon_StringB_Vel01Finger_Cs4_01.ogg
<region> key=62 sample=INSGuitarNylon_StringB_Vel01Finger_D4_01.ogg
<region> key=63 sample=INSGuitarNylon_StringB_Vel01Finger_Ds4_01.ogg
