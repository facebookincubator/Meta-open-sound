// meta-nylon-guitar: full StringHighE map, on any MIDI channel.
// Load on a separate sampler instance/track for explicit string selection.
// Musical settings and velocity mapping match the reference string map.
// Voice choking applies within this instance only.

<control>
default_path=../ogg/

<global>
sw_lokey=24
sw_hikey=26
sw_default=24
loop_mode=one_shot
off_mode=normal
amp_veltrack=60
pitch_random=4
amp_random=1.5

<group> sw_last=24 group=6 off_by=6 lovel=1 hivel=50 xfout_lovel=35 xfout_hivel=50
<region> key=64 sample=INSGuitarNylon_StringHighE_Vel01Finger_E4_01.ogg
<region> key=65 sample=INSGuitarNylon_StringHighE_Vel01Finger_F4_01.ogg
<region> key=66 sample=INSGuitarNylon_StringHighE_Vel01Finger_Fs4_01.ogg
